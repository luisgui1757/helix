      "name": "remediate",
      "kind": "operation",
      "effect": "write",
      "mutatesCheckout": true,
      "reads": [
        "task",
        "plan",
        "lastTest",
        "lastDocumentation",
        "lastReviews",
        "gate",
        "pass",
        "stageModels"
      ],
      "writes": [
