#!/usr/bin/env node

import { Server } from '@modelcontextprotocol/sdk/server/index.js'
import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js'
import { CallToolRequestSchema, ListToolsRequestSchema } from '@modelcontextprotocol/sdk/types.js'
import { createEvidenceService } from '../lib/trusted-evidence.mjs'

const service = createEvidenceService()
const server = new Server(
  { name: 'helix-cc-evidence', version: '0.5.0' },
  { capabilities: { tools: {} } },
)

const SESSION_ID = { type: 'string', pattern: '^hxe_[0-9a-f]{48}$' }
const ARGV = {
  type: 'array', minItems: 1, maxItems: 32,
  items: { type: 'string', minLength: 1, maxLength: 4096 },
}
const PATHS = {
  type: 'array', minItems: 1, maxItems: 2048, uniqueItems: true,
  items: { type: 'string', minLength: 1, maxLength: 512 },
}
const TDD_FILES = {
  type: 'array', minItems: 1, maxItems: 2048, uniqueItems: true,
  items: {
    type: 'object', additionalProperties: false, required: ['path', 'content'],
    properties: {
      path: { type: 'string', minLength: 1, maxLength: 512 },
      content: { type: 'string', maxLength: 8388608 },
    },
  },
}

const tools = [
  {
    name: 'start_session',
    description: 'Create one ephemeral evidence session and return its public receipt-verification key.',
    inputSchema: { type: 'object', additionalProperties: false, properties: {} },
  },
  {
    name: 'capture_baseline',
    description: 'Capture and sign the current Git identity, complete tracked-file state, and exact allowed TDD test paths.',
    inputSchema: {
      type: 'object', additionalProperties: false, required: ['sessionId', 'testPaths'],
      properties: { sessionId: SESSION_ID, testPaths: PATHS },
    },
  },
  {
    name: 'reproduce_red',
    description: 'Execute an exact red attempt in a disposable repository copy and apply only verified signed test contents back to the user checkout.',
    inputSchema: {
      type: 'object', additionalProperties: false, required: ['sessionId', 'baselineSequence', 'argv', 'files'],
      properties: {
        sessionId: SESSION_ID,
        baselineSequence: { type: 'integer', minimum: 1 },
        argv: ARGV,
        files: TDD_FILES,
      },
    },
  },
  {
    name: 'run_command',
    description: 'Execute one exact argv vector without a shell and return a signed command/repository receipt.',
    inputSchema: {
      type: 'object', additionalProperties: false, required: ['sessionId', 'argv', 'purpose'],
      properties: {
        sessionId: SESSION_ID,
        argv: ARGV,
        purpose: { type: 'string', enum: ['verification', 'measurement', 'tests'] },
        metric: {
          type: 'object', additionalProperties: false, required: ['metric', 'unit'],
          properties: {
            metric: { type: 'string', minLength: 1, maxLength: 256 },
            unit: { type: 'string', minLength: 1, maxLength: 64 },
          },
        },
      },
    },
  },
  {
    name: 'verify_pre_pr',
    description: 'Independently verify exact task paths, branch/base state, the verification and release-boundary argv gates, and the diff before shipping.',
    inputSchema: {
      type: 'object', additionalProperties: false, required: ['sessionId', 'repository', 'headBranch', 'baseBranch', 'taskPaths', 'verificationArgv', 'releaseCheckArgv'],
      properties: {
        sessionId: SESSION_ID,
        repository: { type: 'string', pattern: '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$', maxLength: 256 },
        headBranch: { type: 'string', minLength: 1, maxLength: 256 },
        baseBranch: { type: 'string', minLength: 1, maxLength: 256 },
        taskPaths: PATHS,
        verificationArgv: ARGV,
        releaseCheckArgv: ARGV,
      },
    },
  },
  {
    name: 'ship_pre_pr',
    description: 'Stage only verified task paths, create one normal commit, non-force push, create or reuse one exact PR, and attest its live state.',
    inputSchema: {
      type: 'object', additionalProperties: false,
      required: ['sessionId', 'preflightSequence', 'commitMessage', 'pullRequestTitle', 'pullRequestBody'],
      properties: {
        sessionId: SESSION_ID,
        preflightSequence: { type: 'integer', minimum: 1 },
        commitMessage: { type: 'string', minLength: 1, maxLength: 512 },
        pullRequestTitle: { type: 'string', minLength: 1, maxLength: 512 },
        pullRequestBody: { type: 'string', minLength: 1, maxLength: 16384 },
      },
    },
  },
]
if (JSON.stringify(tools.map(tool => tool.name)) !== JSON.stringify(service.toolNames)) {
  throw new Error('trusted-evidence MCP catalog does not match the service contract')
}

server.setRequestHandler(ListToolsRequestSchema, async () => ({ tools }))
server.setRequestHandler(CallToolRequestSchema, async request => {
  const { name, arguments: input = {} } = request.params
  try {
    let result
    if (name === 'start_session') result = service.startSession()
    else if (name === 'capture_baseline') result = { receipt: service.captureBaseline(input) }
    else if (name === 'reproduce_red') result = { receipt: service.reproduceRed(input) }
    else if (name === 'run_command') result = { receipt: service.runCommand(input) }
    else if (name === 'verify_pre_pr') result = { receipt: service.verifyPrePr(input) }
    else if (name === 'ship_pre_pr') result = { receipt: service.shipPrePr(input) }
    else throw new Error('unknown evidence tool')
    return { content: [{ type: 'text', text: JSON.stringify(result) }] }
  } catch (error) {
    return {
      isError: true,
      content: [{ type: 'text', text: error instanceof Error ? error.message : 'trusted evidence operation failed' }],
    }
  }
})

await server.connect(new StdioServerTransport())
